      {
        "emit": { "eventId": "UnitMovementEnded", "params": { "player": { "eventParam": "player" } } }
      }
    ],
    "precedence": { "priority": 10, "strategy": "stack" },
    "provenance": { "source": "Core Rules", "note": "Normal move -- no status applied" }
  },
  {
